@{
    ViewData["Title"] = "Authorize Application";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-4 text-center">
                <div class="mb-3">
                    <span class="badge bg-primary fs-6 px-3 py-2">OAuth Authorization</span>
                </div>
                <h3 class="card-title fw-bold">Authorize @ViewBag.ClientName</h3>
                <p class="text-muted">
                    An external client application is requesting access to your Elixom Claim account on your behalf.
                </p>

                <div class="bg-light p-3 rounded-2 text-start mb-4">
                    <h6 class="fw-bold mb-2">Requested Scopes:</h6>
                    <code class="d-block text-wrap text-break">@ViewBag.Scope</code>
                </div>

                <form asp-controller="OAuth" asp-action="AuthorizeConsent" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="clientId" value="@ViewBag.ClientId" />
                    <input type="hidden" name="redirectUri" value="@ViewBag.RedirectUri" />
                    <input type="hidden" name="scope" value="@ViewBag.Scope" />
                    <input type="hidden" name="state" value="@ViewBag.State" />
                    <input type="hidden" name="codeChallenge" value="@ViewBag.CodeChallenge" />
                    <input type="hidden" name="codeChallengeMethod" value="@ViewBag.CodeChallengeMethod" />

                    <div class="d-grid gap-2">
                        <button type="submit" name="submitAction" value="Approve" class="btn btn-primary btn-lg">Authorize Access</button>
                        <button type="submit" name="submitAction" value="Deny" class="btn btn-outline-secondary">Deny</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@model ElixomClaim.Lib.Entities.CollectionClient
@{ ViewData["Title"] = Model.Name; }
<h1>@Model.Name</h1>
@if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
<div class="row g-4">
<section class="col-md-6"><h2 class="h4">Assigned users</h2><ul>@foreach(var assignment in Model.AssignedUsers){<li>@assignment.User.FullName (@assignment.User.Email)</li>}</ul><form method="post" asp-action="AssignUser"><input type="hidden" name="id" value="@Model.Id" /><label class="form-label" for="userId">User ID</label><input id="userId" name="userId" class="form-control mb-2" required /><button class="btn btn-outline-primary">Assign user</button></form></section>
<section class="col-md-6"><h2 class="h4">Purpose options</h2><ul>@foreach(var option in Model.PurposeOptions.OrderBy(x => x.DisplayOrder)){<li>@option.Name</li>}</ul><form method="post" asp-action="AddPurpose"><input type="hidden" name="id" value="@Model.Id" /><input name="name" class="form-control mb-2" placeholder="Purpose" required /><input name="displayOrder" type="number" class="form-control mb-2" value="0" /><button class="btn btn-outline-primary">Add purpose</button></form></section>
<section class="col-md-6"><h2 class="h4">Amount options</h2><ul>@foreach(var option in Model.AmountOptions.OrderBy(x => x.DisplayOrder)){<li>@option.Name — @option.Amount.ToString("N2") JMD</li>}</ul><form method="post" asp-action="AddAmount"><input type="hidden" name="id" value="@Model.Id" /><input name="name" class="form-control mb-2" placeholder="Option name" required /><input name="amount" type="number" step="0.01" min="0.01" class="form-control mb-2" required /><input name="displayOrder" type="number" class="form-control mb-2" value="0" /><button class="btn btn-outline-primary">Add amount</button></form></section>
<section class="col-md-6"><h2 class="h4">Bank details</h2><ul>@foreach(var detail in Model.BankDetails){<li>@detail.BankName — @detail.AccountName</li>}</ul><form method="post" asp-action="AddBankDetail"><input type="hidden" name="id" value="@Model.Id" /><input name="accountName" class="form-control mb-2" placeholder="Account name" required /><input name="bankName" class="form-control mb-2" placeholder="Bank name" required /><input name="branchCode" class="form-control mb-2" placeholder="Branch code" required /><input name="accountNumber" class="form-control mb-2" placeholder="Account number" required /><button class="btn btn-outline-primary">Add bank detail</button></form></section>
</div>

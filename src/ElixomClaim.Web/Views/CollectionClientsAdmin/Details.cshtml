@model ElixomClaim.Web.Models.CollectionClientDetailsViewModel
@{
    ViewData["Title"] = Model.Client.Name;
    var client = Model.Client;
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Collection Client: @client.Name</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Clients</a>
    </div>

    @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Client Configuration & Fee Schedule</h5>
        </div>
        <div class="card-body p-4">
            <form method="post" asp-action="Update" asp-route-id="@client.Id">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="clientName" class="form-label fw-bold">Client Name</label>
                        <input id="clientName" name="name" class="form-control" value="@client.Name" required />
                    </div>
                    <div class="col-md-6">
                        <label for="clientDescription" class="form-label fw-bold">Public Description</label>
                        <input id="clientDescription" name="description" class="form-control" value="@client.Description" placeholder="Optional description..." />
                    </div>
                    <div class="col-12">
                        <label for="clientNotes" class="form-label fw-bold">Internal Notes</label>
                        <textarea id="clientNotes" name="notes" class="form-control" rows="2" placeholder="Internal operational notes...">@client.Notes</textarea>
                    </div>
                    <div class="col-md-6">
                        <label for="perJobProcessingFee" class="form-label fw-bold">Per-Job Processing Fee (JMD)</label>
                        <input id="perJobProcessingFee" name="perJobProcessingFee" type="number" step="0.01" min="0" class="form-control" value="@client.PerJobProcessingFee" required />
                    </div>
                    <div class="col-md-6">
                        <label for="perTransactionFee" class="form-label fw-bold">Per-Txn Processing Fee (JMD)</label>
                        <input id="perTransactionFee" name="perTransactionFee" type="number" step="0.01" min="0" class="form-control" value="@client.PerTransactionFee" required />
                    </div>
                </div>
                <div class="mt-3 text-end">
                    <button type="submit" class="btn btn-primary">Save Client Settings</button>
                </div>
            </form>
            <div class="d-flex justify-content-between align-items-center border-top mt-4 pt-3">
                <span class="text-muted">Status: <strong class="@(client.IsActive ? "text-success" : "text-secondary")">@(client.IsActive ? "Active" : "Disabled")</strong></span>
                <form method="post" asp-action="SetActive" asp-route-id="@client.Id">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="isActive" value="@(!client.IsActive)" />
                    <button type="submit" class="btn @(client.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                        @(client.IsActive ? "Disable client" : "Re-enable client")
                    </button>
                </form>
            </div>
        </div>
    </div>

    @{ var canManageOptions = User.IsInRole("Administrator"); }
    <div class="row g-4">
        @if (canManageOptions)
        {
        <section class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light"><h5 class="mb-0">Assigned Users</h5></div>
                <div class="card-body">
                    <ul class="list-group list-group-flush mb-3">
                        @foreach(var assignment in client.AssignedUsers)
                        {
                            <li class="list-group-item">@assignment.User.FullName (<code>@assignment.User.Email</code>)</li>
                        }
                    </ul>
                    @if (Model.AvailableUsers.Count == 0)
                    {
                        <p class="text-muted mb-0">All active users are already assigned to this client.</p>
                    }
                    else
                    {
                        <form method="post" asp-action="AssignUser" asp-route-id="@client.Id">
                            @Html.AntiForgeryToken()
                            <label class="form-label fw-bold" for="userSearch">Find an active user</label>
                            <input id="userSearch" type="search" class="form-control mb-2" autocomplete="off" placeholder="Search by name or email" aria-describedby="userSearchHelp userSearchStatus" />
                            <div id="userSearchHelp" class="form-text mb-2">Only active users not yet assigned to this client are shown.</div>
                            <label class="form-label fw-bold" for="userId">User to assign</label>
                            <select id="userId" name="userId" class="form-select mb-2" size="6" required>
                                @foreach (var user in Model.AvailableUsers)
                                {
                                    <option value="@user.Id" data-search="@($"{user.Name} {user.Email}".ToLowerInvariant())">@user.Name — @user.Email</option>
                                }
                            </select>
                            <div id="userSearchStatus" class="visually-hidden" role="status" aria-live="polite"></div>
                            <button class="btn btn-outline-primary btn-sm">Assign selected user</button>
                        </form>
                    }
                </div>
            </div>
        </section>
        }

        <section class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light"><h5 class="mb-0">Purpose options</h5></div>
                <div class="card-body">
                    <p class="small text-muted">Predefined purposes shown to tellers for this client. Deactivate an option to preserve past collections while removing it from new entries.</p>
                    <ul class="list-group list-group-flush mb-3">
                        @foreach(var option in client.PurposeOptions.OrderBy(x => x.DisplayOrder))
                        {
                            <li class="list-group-item px-0">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                    <div><strong>@option.Name</strong> <span class="badge text-bg-@(option.IsActive ? "success" : "secondary")">@(option.IsActive ? "Active" : "Inactive")</span><span class="small text-muted ms-2">Display order: @option.DisplayOrder</span></div>
                                    @if (canManageOptions)
                                    {
                                    <div class="d-flex gap-2">
                                        <form method="post" asp-action="SetPurposeActive" asp-route-id="@client.Id" asp-route-optionId="@option.Id">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="isActive" value="@(!option.IsActive)" />
                                            <button type="submit" class="btn btn-sm @(option.IsActive ? "btn-outline-secondary" : "btn-outline-success")">@(option.IsActive ? "Deactivate" : "Activate")</button>
                                        </form>
                                        <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#edit-purpose-@option.Id" aria-expanded="false" aria-controls="edit-purpose-@option.Id">Edit</button>
                                    </div>
                                    }
                                </div>
                                @if (canManageOptions)
                                {
                                <div id="edit-purpose-@option.Id" class="collapse mt-3">
                                    <form method="post" asp-action="UpdatePurpose" asp-route-id="@client.Id" asp-route-optionId="@option.Id" class="row g-2 align-items-end">
                                        @Html.AntiForgeryToken()
                                        <div class="col-sm-8"><label class="form-label small" for="purpose-name-@option.Id">Purpose name</label><input id="purpose-name-@option.Id" name="name" class="form-control form-control-sm" value="@option.Name" required /></div>
                                        <div class="col-sm-4"><label class="form-label small" for="purpose-order-@option.Id">Display order</label><input id="purpose-order-@option.Id" name="displayOrder" type="number" class="form-control form-control-sm" value="@option.DisplayOrder" required /></div>
                                        <div class="col-12"><button class="btn btn-sm btn-primary">Save purpose</button></div>
                                    </form>
                                </div>
                                }
                            </li>
                        }
                    </ul>
                    @if (canManageOptions)
                    {
                    <form method="post" asp-action="AddPurpose" asp-route-id="@client.Id" class="border-top pt-3">
                        @Html.AntiForgeryToken()
                        <h6>Add purpose option</h6>
                        <div class="row g-2 align-items-end"><div class="col-sm-8"><label class="form-label small" for="new-purpose-name">Purpose name</label><input id="new-purpose-name" name="name" class="form-control form-control-sm" required /></div><div class="col-sm-4"><label class="form-label small" for="new-purpose-order">Display order</label><input id="new-purpose-order" name="displayOrder" type="number" class="form-control form-control-sm" value="0" required /></div><div class="col-12"><button class="btn btn-outline-primary btn-sm">Add purpose</button></div></div>
                    </form>
                    }
                </div>
            </div>
        </section>

        <section class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light"><h5 class="mb-0">Amount options</h5></div>
                <div class="card-body">
                    <p class="small text-muted">Predefined JMD amounts shown to tellers for this client. Deactivation keeps financial history intact.</p>
                    <ul class="list-group list-group-flush mb-3">
                        @foreach(var option in client.AmountOptions.OrderBy(x => x.DisplayOrder))
                        {
                            <li class="list-group-item px-0">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                    <div><strong>@option.Name</strong> — <span class="fw-semibold">$@option.Amount.ToString("N2") JMD</span> <span class="badge text-bg-@(option.IsActive ? "success" : "secondary")">@(option.IsActive ? "Active" : "Inactive")</span><span class="small text-muted ms-2">Display order: @option.DisplayOrder</span></div>
                                    @if (canManageOptions)
                                    {
                                    <div class="d-flex gap-2">
                                        <form method="post" asp-action="SetAmountActive" asp-route-id="@client.Id" asp-route-optionId="@option.Id">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="isActive" value="@(!option.IsActive)" />
                                            <button type="submit" class="btn btn-sm @(option.IsActive ? "btn-outline-secondary" : "btn-outline-success")">@(option.IsActive ? "Deactivate" : "Activate")</button>
                                        </form>
                                        <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#edit-amount-@option.Id" aria-expanded="false" aria-controls="edit-amount-@option.Id">Edit</button>
                                    </div>
                                    }
                                </div>
                                @if (canManageOptions)
                                {
                                <div id="edit-amount-@option.Id" class="collapse mt-3">
                                    <form method="post" asp-action="UpdateAmount" asp-route-id="@client.Id" asp-route-optionId="@option.Id" class="row g-2 align-items-end">
                                        @Html.AntiForgeryToken()
                                        <div class="col-sm-5"><label class="form-label small" for="amount-name-@option.Id">Option name</label><input id="amount-name-@option.Id" name="name" class="form-control form-control-sm" value="@option.Name" required /></div>
                                        <div class="col-sm-4"><label class="form-label small" for="amount-value-@option.Id">Amount (JMD)</label><input id="amount-value-@option.Id" name="amount" type="number" min="0.01" step="0.01" class="form-control form-control-sm" value="@option.Amount" required /></div>
                                        <div class="col-sm-3"><label class="form-label small" for="amount-order-@option.Id">Display order</label><input id="amount-order-@option.Id" name="displayOrder" type="number" class="form-control form-control-sm" value="@option.DisplayOrder" required /></div>
                                        <div class="col-12"><button class="btn btn-sm btn-primary">Save amount</button></div>
                                    </form>
                                </div>
                                }
                            </li>
                        }
                    </ul>
                    @if (canManageOptions)
                    {
                    <form method="post" asp-action="AddAmount" asp-route-id="@client.Id" class="border-top pt-3">
                        @Html.AntiForgeryToken()
                        <h6>Add amount option</h6>
                        <div class="row g-2 align-items-end"><div class="col-sm-5"><label class="form-label small" for="new-amount-name">Option name</label><input id="new-amount-name" name="name" class="form-control form-control-sm" required /></div><div class="col-sm-4"><label class="form-label small" for="new-amount-value">Amount (JMD)</label><input id="new-amount-value" name="amount" type="number" min="0.01" step="0.01" class="form-control form-control-sm" required /></div><div class="col-sm-3"><label class="form-label small" for="new-amount-order">Display order</label><input id="new-amount-order" name="displayOrder" type="number" class="form-control form-control-sm" value="0" required /></div><div class="col-12"><button class="btn btn-outline-primary btn-sm">Add amount</button></div></div>
                    </form>
                    }
                </div>
            </div>
        </section>

        @if (canManageOptions)
        {
        <section class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light"><h5 class="mb-0">Bank Details & Internal Notes</h5></div>
                <div class="card-body">
                    <ul class="list-group list-group-flush mb-3">
                        @foreach(var detail in client.BankDetails)
                        {
                            <li class="list-group-item">
                                <div><strong>@detail.BankName</strong> — @detail.AccountName (<code>@detail.AccountNumber</code>)</div>
                                <small class="text-muted">@detail.BranchName (@detail.BranchCode) · @detail.AccountType</small>
                                @if (!string.IsNullOrWhiteSpace(detail.Notes))
                                {
                                    <small class="text-muted">Internal note: @detail.Notes</small>
                                }
                            </li>
                        }
                    </ul>
                    <form method="post" asp-action="AddBankDetail" asp-route-id="@client.Id">
                        @Html.AntiForgeryToken()
                        <input name="accountName" class="form-control mb-2" placeholder="Account name" required />
                        <input name="bankName" class="form-control mb-2" placeholder="Bank name" required />
                        <input name="branchCode" class="form-control mb-2" placeholder="Branch code" required />
                        <input name="branchName" class="form-control mb-2" placeholder="Branch name" required />
                        <select name="accountType" class="form-select mb-2" required>
                            <option value="">Select account type</option>
                            <option value="Savings">Savings</option>
                            <option value="Current">Current / Chequing</option>
                        </select>
                        <input name="accountNumber" class="form-control mb-2" placeholder="Account number" required />
                        <input name="notes" class="form-control mb-2" placeholder="Internal bank notes (Admin only)" />
                        <button class="btn btn-outline-primary btn-sm">Add Bank Detail</button>
                    </form>
                </div>
            </div>
        </section>
        }
    </div>
</div>

@if (User.IsInRole("Administrator"))
{
    <script>
        (() => {
            const search = document.getElementById('userSearch');
            const select = document.getElementById('userId');
            const status = document.getElementById('userSearchStatus');
            if (!search || !select || !status) return;

            const filterUsers = () => {
                const query = search.value.trim().toLowerCase();
                let visible = 0;
                for (const option of select.options) {
                    const matches = !query || option.dataset.search.includes(query);
                    option.hidden = !matches;
                    if (matches) visible++;
                }

                if (select.selectedOptions.length && select.selectedOptions[0].hidden) {
                    select.value = '';
                }
                status.textContent = `${visible} user${visible === 1 ? '' : 's'} available.`;
            };

            search.addEventListener('input', filterUsers);
            filterUsers();
        })();
    </script>
}

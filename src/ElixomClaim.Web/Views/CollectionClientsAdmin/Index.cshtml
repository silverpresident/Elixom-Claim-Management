@model IEnumerable<ElixomClaim.Lib.Entities.CollectionClient>
@{ ViewData["Title"] = "Collection clients"; }

<div class="container my-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Collection clients</h1>
            <p class="text-muted mb-0">Manage client details, assigned users, bank details, and teller transaction options.</p>
        </div>
        <a class="btn btn-primary" asp-action="Create">Add client</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No collection clients have been configured.</div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="list-group list-group-flush">
                @foreach (var client in Model)
                {
                    <div class="list-group-item d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 py-3">
                        <div>
                            <div class="fw-semibold">Client #@client.SequenceNo — @client.Name <span class="badge text-bg-@(client.IsActive ? "success" : "secondary")">@(client.IsActive ? "Active" : "Inactive")</span></div>
                            <div class="small text-muted">Configure purposes, preset amounts, users, bank details, and fees.</div>
                        </div>
                        <a class="btn btn-sm btn-outline-primary align-self-md-center" asp-action="Details" asp-route-id="@client.Id">Manage client</a>
                    </div>
                }
            </div>
        </div>
    }
</div>

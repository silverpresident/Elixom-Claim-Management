@model IEnumerable<ElixomClaim.Lib.Entities.CollectionClient>
@{ ViewData["Title"] = "Collection clients"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Collection clients</h1><a class="btn btn-primary" asp-action="Create">Add client</a></div>
@if (!Model.Any()) { <p class="text-muted">No collection clients have been configured.</p> }
else { <div class="list-group">@foreach (var client in Model) { <a class="list-group-item list-group-item-action" asp-action="Details" asp-route-id="@client.Id">@client.Name <span class="badge text-bg-@(client.IsActive ? "success" : "secondary")">@(client.IsActive ? "Active" : "Inactive")</span></a> }</div> }

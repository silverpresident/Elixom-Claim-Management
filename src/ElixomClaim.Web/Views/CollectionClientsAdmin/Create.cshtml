@{ ViewData["Title"] = "Add collection client"; }
<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white p-3">
                    <h4 class="mb-0">Add Collection Client</h4>
                </div>
                <div class="card-body p-4">
                    <form method="post" asp-action="Create">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label for="name" class="form-label fw-bold">Client Name</label>
                            <input id="name" name="name" class="form-control" required maxlength="200" placeholder="e.g. Utility Company" />
                        </div>

                        <div class="mb-3">
                            <label for="description" class="form-label fw-bold">Description</label>
                            <textarea id="description" name="description" class="form-control" rows="2" placeholder="Public client description..."></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="notes" class="form-label fw-bold">Internal Notes (Admin only)</label>
                            <textarea id="notes" name="notes" class="form-control" rows="2" placeholder="Internal operational notes..."></textarea>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label for="perJobFee" class="form-label fw-bold">Per-Job Processing Fee (JMD)</label>
                                <input id="perJobFee" name="perJobProcessingFee" type="number" step="0.01" min="0" value="0.00" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label for="perTxnFee" class="form-label fw-bold">Per-Txn Processing Fee (JMD)</label>
                                <input id="perTxnFee" name="perTransactionFee" type="number" step="0.01" min="0" value="0.00" class="form-control" required />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">Save Client</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

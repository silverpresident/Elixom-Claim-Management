@{ ViewData["Title"] = "Add collection client"; }
<h1>Add collection client</h1>
<form method="post" class="col-md-6"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label for="name" class="form-label">Client name</label><input id="name" name="name" class="form-control" required maxlength="200" /></div><button class="btn btn-primary">Save client</button> <a asp-action="Index" class="btn btn-link">Cancel</a></form>

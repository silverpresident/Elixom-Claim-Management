@model IEnumerable<ElixomClaim.Lib.Entities.JobPayment>
@{
    ViewData["Title"] = "My Payment History";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Payment History</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to My Claims</a>
    </div>

    @if (!Model.Any())
    {
        <div class="card p-4 text-center shadow-sm border-0">
            <p class="text-muted mb-0">No payment records found for your account.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Payment Ref</th>
                            <th>Title / Description</th>
                            <th>Status</th>
                            <th>Amount (JMD)</th>
                            <th>Payment Date (UTC)</th>
                            <th>Transaction No.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model)
                        {
                            <tr>
                                <td><code>#@job.SequenceNo</code></td>
                                <td><strong>@(job.Title ?? job.PublicNote ?? "Direct Payout")</strong></td>
                                <td><span class="badge @(job.Status == ElixomClaim.Lib.Entities.JobPaymentStatus.Paid ? "bg-success" : "bg-secondary")">@job.Status</span></td>
                                <td class="fw-bold">$@job.TotalPaid.ToString("N2") JMD</td>
                                <td>@(job.PaymentDateUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                <td><code>@(string.IsNullOrWhiteSpace(job.PaymentTransactionNumber) ? "—" : job.PaymentTransactionNumber)</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

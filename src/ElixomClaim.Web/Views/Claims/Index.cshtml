@model ElixomClaim.Web.Models.UserDashboardViewModel
@{
    ViewData["Title"] = "My Claims & Payment History";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Claims Dashboard</h2>
        <div class="d-flex gap-2">
            <a asp-action="History" class="btn btn-outline-primary">Claims History</a>
            <a asp-action="Create" class="btn btn-primary">+ New Claim</a>
        </div>
    </div>

    @if (!Model.Claims.Any())
    {
        <div class="card p-5 text-center shadow-sm border-0 mb-5">
            <div class="card-body">
                <i class="bi bg-light p-3 rounded-circle fs-1 mb-3 text-muted">📄</i>
                <h4>No unresolved claims</h4>
                <p class="text-muted mb-4">Your current claims are resolved. Use Claims History to review earlier claims.</p>
                <a asp-action="Create" class="btn btn-primary">Create Your First Claim</a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 mb-5">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">My Unresolved Claims</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Claim no.</th>
                                <th>Title</th>
                                <th>Amount (JMD)</th>
                                <th>Status</th>
                                <th>Payment State</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var claim in Model.Claims)
                            {
                                <tr>
                                    <td>#@claim.SequenceNo</td>
                                    <td><strong>@claim.Title</strong></td>
                                    <td>$@claim.Amount.ToString("N2") JMD</td>
                                    <td>
                                        @switch (claim.Status)
                                        {
                                            case ElixomClaim.Lib.Entities.ClaimStatus.Draft:
                                                <span class="badge bg-secondary">Draft</span>
                                                break;
                                            case ElixomClaim.Lib.Entities.ClaimStatus.Submitted:
                                                <span class="badge bg-primary">Submitted</span>
                                                break;
                                            case ElixomClaim.Lib.Entities.ClaimStatus.Accepted:
                                                <span class="badge bg-success">Accepted</span>
                                                break;
                                            case ElixomClaim.Lib.Entities.ClaimStatus.Rejected:
                                                <span class="badge bg-danger">Rejected</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @switch (claim.PaymentStatus)
                                        {
                                            case ElixomClaim.Lib.Entities.ClaimPaymentStatus.Unpaid:
                                                <span class="badge bg-outline-secondary text-dark border">Unpaid</span>
                                                break;
                                            case ElixomClaim.Lib.Entities.ClaimPaymentStatus.Processing:
                                                <span class="badge bg-info text-dark">Processing</span>
                                                break;
                                            case ElixomClaim.Lib.Entities.ClaimPaymentStatus.Paid:
                                                <span class="badge bg-success">Paid</span>
                                                break;
                                        }
                                    </td>
                                    <td>@claim.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@claim.Id" class="btn btn-sm btn-outline-primary">View</a>
                                        @if (claim.Status == ElixomClaim.Lib.Entities.ClaimStatus.Draft)
                                        {
                                            <a asp-action="Edit" asp-route-id="@claim.Id" class="btn btn-sm btn-outline-secondary ms-1">Edit</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Recent Payments</h3>
            <a asp-action="PaymentHistory" class="btn btn-outline-primary btn-sm">View payment history</a>
        </div>

        @if (!Model.PaymentHistory.Any())
        {
            <div class="card p-4 text-center shadow-sm border-0">
                <div class="card-body">
                    <p class="text-muted mb-0">No recent payment records found for your account.</p>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Payment Ref</th>
                                    <th>Title / Description</th>
                                    <th>Status</th>
                                    <th>Amount (JMD)</th>
                                    <th>Payment Date (UTC)</th>
                                    <th>Transaction No.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var job in Model.PaymentHistory)
                                {
                                    <tr>
                                        <td><code>#@job.SequenceNo</code></td>
                                        <td><strong>@(job.Title ?? job.PublicNote ?? "Direct Payout")</strong></td>
                                        <td>
                                            @switch (job.Status)
                                            {
                                                case ElixomClaim.Lib.Entities.JobPaymentStatus.Processing:
                                                    <span class="badge bg-secondary">Processing</span>
                                                    break;
                                                case ElixomClaim.Lib.Entities.JobPaymentStatus.Submitted:
                                                    <span class="badge bg-info text-dark">Submitted</span>
                                                    break;
                                                case ElixomClaim.Lib.Entities.JobPaymentStatus.Scheduled:
                                                    <span class="badge bg-warning text-dark">Scheduled</span>
                                                    break;
                                                case ElixomClaim.Lib.Entities.JobPaymentStatus.Paid:
                                                    <span class="badge bg-success">Paid</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="fw-bold">$@job.TotalPaid.ToString("N2") JMD</td>
                                        <td>@(job.PaymentDateUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                        <td><code>@(string.IsNullOrWhiteSpace(job.PaymentTransactionNumber) ? "—" : job.PaymentTransactionNumber)</code></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

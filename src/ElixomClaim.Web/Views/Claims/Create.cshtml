@{
    ViewData["Title"] = "New Claim";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white p-3">
                    <h4 class="mb-0">Create Expense Claim</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Claim Title</label>
                            <input type="text" name="title" class="form-control" placeholder="e.g. Travel & Taxi Expense" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Amount (JMD)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" name="amount" step="0.01" min="0.01" class="form-control" placeholder="0.00" required />
                                <span class="input-group-text">JMD</span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Description & Justification</label>
                            <textarea name="description" class="form-control" rows="4" placeholder="Provide details about the claim..." required></textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">Save Draft Claim</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@model ElixomClaim.Web.Controllers.RecordCollectionInput
@using ElixomClaim.Lib.Entities
@{ ViewData["Title"] = "Record collection"; var clients = (IEnumerable<CollectionClient>)ViewBag.Clients; var purposes = (IEnumerable<CollectionPurposeOption>)ViewBag.Purposes; var amounts = (IEnumerable<CollectionAmountOption>)ViewBag.Amounts; }
<h1>Record collection</h1><p class="text-muted">Only active options belonging to the selected client can be recorded.</p>
<form method="post" class="row g-3"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-6"><label asp-for="CollectionClientId" class="form-label">Client</label><select asp-for="CollectionClientId" class="form-select" required><option value="">Choose a client</option>@foreach(var client in clients){<option value="@client.Id">@client.Name</option>}</select></div><div class="col-md-6"><label asp-for="PurposeOptionId" class="form-label">Purpose</label><select asp-for="PurposeOptionId" class="form-select" required><option value="">Choose a purpose</option>@foreach(var option in purposes){<option value="@option.Id" data-client="@option.CollectionClientId">@option.Name</option>}</select></div><div class="col-md-6"><label asp-for="AmountOptionId" class="form-label">Amount</label><select asp-for="AmountOptionId" class="form-select" required><option value="">Choose an amount</option>@foreach(var option in amounts){<option value="@option.Id" data-client="@option.CollectionClientId">@option.Name — @option.Amount.ToString("N2") JMD</option>}</select></div><div class="col-md-6"><label asp-for="Method" class="form-label">Method</label><select asp-for="Method" asp-items="Html.GetEnumSelectList<CollectionMethod>()" class="form-select"></select></div><div class="col-md-6"><label asp-for="PayorName" class="form-label">Payor name</label><input asp-for="PayorName" class="form-control" required /></div><div class="col-md-6"><label asp-for="PayorEmail" class="form-label">Payor email <span class="text-muted">(optional)</span></label><input asp-for="PayorEmail" type="email" class="form-control" /></div><div class="col-md-6"><label asp-for="ProcessingFee" class="form-label">Internal processing fee (JMD)</label><input asp-for="ProcessingFee" type="number" min="0" step="0.01" class="form-control" /></div><div class="col-md-6"><label asp-for="PaymentDateUtc" class="form-label">Payment date/time (UTC)</label><input asp-for="PaymentDateUtc" type="datetime-local" class="form-control" /></div><div class="col-12"><label asp-for="ReferenceNumber" class="form-label">Reference <span class="text-muted">(optional)</span></label><input asp-for="ReferenceNumber" class="form-control" maxlength="100" /></div><div class="col-12"><button class="btn btn-primary">Record collection</button> <a asp-action="Index" class="btn btn-link">Cancel</a></div></form>
@section Scripts { <script>$(function(){ const filter=()=>{const c=$('#CollectionClientId').val(); $('#PurposeOptionId option[data-client],#AmountOptionId option[data-client]').each(function(){$(this).prop('hidden', !!c && $(this).data('client') != c);});}; $('#CollectionClientId').on('change',filter);filter();});</script> }

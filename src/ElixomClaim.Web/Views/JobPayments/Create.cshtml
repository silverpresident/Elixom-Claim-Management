@using ElixomClaim.Lib.Entities
@{
    ViewData["Title"] = "Create Job Payment";
    var users = (IEnumerable<User>)(ViewBag.Users ?? Enumerable.Empty<User>());
    var clients = (IEnumerable<CollectionClient>)(ViewBag.Clients ?? Enumerable.Empty<CollectionClient>());
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white p-3">
                    <h4 class="mb-0">Create Job Payment</h4>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted">A job payment belongs to either an individual payee user OR a collection client (mutually exclusive).</p>

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label for="title" class="form-label fw-bold">Job Payment Title</label>
                            <input type="text" id="title" name="title" class="form-control" placeholder="e.g. Monthly Expense Settlement" required />
                        </div>

                        <div class="mb-3">
                            <label for="payeeUserId" class="form-label fw-bold">Payee User <span class="text-muted fw-normal">(for claim reimbursements)</span></label>
                            <select id="payeeUserId" name="payeeUserId" class="form-select">
                                <option value="">-- None (Choose Collection Client below) --</option>
                                @foreach (var user in users)
                                {
                                    <option value="@user.Id">@user.FullName (@user.Email)</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="collectionClientId" class="form-label fw-bold">Collection Client <span class="text-muted fw-normal">(for clearing house payouts)</span></label>
                            <select id="collectionClientId" name="collectionClientId" class="form-select">
                                <option value="">-- None (Choose Payee User above) --</option>
                                @foreach (var client in clients)
                                {
                                    <option value="@client.Id">@client.Name</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="publicNote" class="form-label fw-bold">Public Note / Description</label>
                            <textarea id="publicNote" name="publicNote" class="form-control" rows="2" placeholder="Note visible on payee statements..."></textarea>
                        </div>

                        <div class="mb-4">
                            <label for="internalNote" class="form-label fw-bold">Internal Note <span class="text-muted fw-normal">(Manager & Accountant only)</span></label>
                            <textarea id="internalNote" name="internalNote" class="form-control" rows="2" placeholder="Internal processing notes..."></textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">Create Processing Job</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

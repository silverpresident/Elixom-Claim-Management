@model IEnumerable<ElixomClaim.Lib.Entities.JobPayment>
@{ ViewData["Title"] = "Accountant payment queue"; }
<h1>Accountant payment queue</h1><p class="text-muted">Submitted payments await scheduling; scheduled payments await settlement.</p><table class="table"><thead><tr><th>Payment</th><th>Payee</th><th>Status</th><th>Scheduled</th><th>Total</th></tr></thead><tbody>@foreach(var job in Model){<tr><td><a asp-action="Details" asp-route-id="@job.Id">#@job.Id</a></td><td>@(job.PayeeUser?.FullName ?? job.CollectionClient?.Name)</td><td>@job.Status</td><td>@(job.ScheduledAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "Awaiting schedule")</td><td>@job.TotalPaid.ToString("N2") JMD</td></tr>}</tbody></table>

@model IEnumerable<ElixomClaim.Lib.Entities.Claim>
@{
    var job = (ElixomClaim.Lib.Entities.JobPayment)ViewBag.Job;
    ViewData["Title"] = $"Attach Claims to Job #{job.SequenceNo}";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Eligible Accepted Claims for Payee</h2>
            <p class="text-muted mb-0">Select one or more accepted claims for <strong>@job.PayeeUser?.FullName</strong> to attach to Job #@job.SequenceNo.</p>
        </div>
        <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-outline-secondary">Back to Job Payment</a>
    </div>

    @if (!Model.Any())
    {
        <div class="card p-4 text-center shadow-sm border-0">
            <div class="card-body">
                <p class="text-muted mb-0">No unattached accepted claims are available for this user.</p>
            </div>
        </div>
    }
    else
    {
        <form asp-action="AttachClaims" asp-route-id="@job.Id" method="post">
            @Html.AntiForgeryToken()
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="select-all-claims" />
                    <label class="form-check-label" for="select-all-claims">Select all</label>
                </div>
                <button type="submit" class="btn btn-primary">Attach selected</button>
            </div>
            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col"><span class="visually-hidden">Select</span></th>
                                    <th scope="col">Claim no.</th>
                                    <th scope="col">Title</th>
                                    <th scope="col">Amount (JMD)</th>
                                    <th scope="col">Date of Job</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var claim in Model)
                                {
                                    <tr>
                                        <td><input class="form-check-input claim-selector" type="checkbox" name="claimIds" value="@claim.Id" id="claim-@claim.Id" /></td>
                                        <td><label for="claim-@claim.Id"><code>#@claim.SequenceNo</code></label></td>
                                        <td><strong>@claim.Title</strong></td>
                                        <td>@claim.Amount.ToString("N2") JMD</td>
                                        <td>@claim.DateOfJob.ToString("yyyy-MM-dd")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </form>
    }
</div>

@section Scripts {
<script>
    (() => {
        const selectAll = document.getElementById('select-all-claims');
        const selectors = Array.from(document.querySelectorAll('.claim-selector'));
        if (!selectAll || selectors.length === 0) return;

        const updateSelectAll = () => {
            const selected = selectors.filter(selector => selector.checked).length;
            selectAll.checked = selected === selectors.length;
            selectAll.indeterminate = selected > 0 && selected < selectors.length;
        };

        selectAll.addEventListener('change', () => selectors.forEach(selector => selector.checked = selectAll.checked));
        selectors.forEach(selector => selector.addEventListener('change', updateSelectAll));
    })();
</script>
}

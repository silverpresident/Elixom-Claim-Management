@model IEnumerable<ElixomClaim.Lib.Entities.Claim>
@{
    var job = (ElixomClaim.Lib.Entities.JobPayment)ViewBag.Job;
    ViewData["Title"] = $"Attach Claims to Job #{job.SequenceNo}";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Eligible Accepted Claims for Payee</h2>
            <p class="text-muted mb-0">Select an accepted claim for <strong>@job.PayeeUser?.FullName</strong> to attach to Job #@job.SequenceNo.</p>
        </div>
        <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-outline-secondary">Back to Job Payment</a>
    </div>

    @if (!Model.Any())
    {
        <div class="card p-4 text-center shadow-sm border-0">
            <div class="card-body">
                <p class="text-muted mb-0">No unattached accepted claims are available for this user.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Claim no.</th>
                                <th>Title</th>
                                <th>Amount (JMD)</th>
                                <th>Date of Job</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var claim in Model)
                            {
                                <tr>
                                    <td><code>#@claim.SequenceNo</code></td>
                                    <td><strong>@claim.Title</strong></td>
                                    <td>$@claim.Amount.ToString("N2") JMD</td>
                                    <td>@claim.DateOfJob.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <form asp-action="AttachClaim" asp-route-id="@job.Id" asp-route-claimId="@claim.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-primary">+ Attach Claim</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

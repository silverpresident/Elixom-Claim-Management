@model ElixomClaim.Lib.Entities.JobPayment
@{ ViewData["Title"] = $"Job payment #{Model.SequenceNo}"; var claims = Model.Claims.Sum(x => x.Claim.Amount); var collections = Model.Collections.Sum(x => x.CollectionTransaction.Amount); var payrolls = Model.Payrolls.Sum(x => x.Payroll.PayrollTotal); }
<article class="container my-4 payout-print" aria-labelledby="summary-heading">
    <header><h1 id="summary-heading">Job payment summary</h1><dl class="row"><dt class="col-sm-3">Payment</dt><dd class="col-sm-9">#@Model.SequenceNo</dd><dt class="col-sm-3">Payee</dt><dd class="col-sm-9">@(Model.PayeeUser?.FullName ?? Model.CollectionClient?.Name)</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd></dl></header>
    @if (Model.IsAdjustment) { <section aria-labelledby="adjustment-heading"><h2 id="adjustment-heading">Adjustment</h2><p>Reason: @Model.AdjustmentReason</p>@if (Model.OriginalJobPaymentId.HasValue) { <p>Original payment: #@Model.OriginalJobPayment?.SequenceNo</p> }</section> }
    <section aria-labelledby="claims-heading"><h2 id="claims-heading">Claims</h2>
        @if (!Model.Claims.Any()) { <p>No claims are attached.</p> } else { <div class="table-responsive"><table class="table table-sm table-bordered"><caption>Claims included in this payment</caption><thead><tr><th scope="col">Claim</th><th scope="col">Title</th><th scope="col" class="text-end">Amount (JMD)</th></tr></thead><tbody>@foreach (var item in Model.Claims.OrderBy(x => x.Claim.SequenceNo)) { <tr><th scope="row">#@item.Claim.SequenceNo</th><td>@item.Claim.Title</td><td class="text-end">@item.Claim.Amount.ToString("N2")</td></tr> }</tbody><tfoot><tr><th scope="rowgroup" colspan="2">Claims subtotal</th><td class="text-end">@claims.ToString("N2") JMD</td></tr></tfoot></table></div> }
    </section>
    <section aria-labelledby="collections-heading"><h2 id="collections-heading">Collection transactions</h2>
        @if (!Model.Collections.Any()) { <p>No collection transactions are attached.</p> } else { <div class="table-responsive"><table class="table table-sm table-bordered"><caption>Collection transactions included in this payment</caption><thead><tr><th scope="col">Collection</th><th scope="col">Purpose</th><th scope="col">Payor</th><th scope="col" class="text-end">Amount (JMD)</th><th scope="col" class="text-end">Transaction fee (JMD)</th></tr></thead><tbody>@foreach (var item in Model.Collections.OrderBy(x => x.CollectionTransaction.SequenceNo)) { <tr><th scope="row">#@item.CollectionTransaction.SequenceNo</th><td>@item.CollectionTransaction.Purpose</td><td>@item.CollectionTransaction.PayorName@if (!string.IsNullOrWhiteSpace(item.CollectionTransaction.PayorEmail)) { <br /><span>@item.CollectionTransaction.PayorEmail</span> }</td><td class="text-end">@item.CollectionTransaction.Amount.ToString("N2")</td><td class="text-end">@item.CollectionTransaction.ProcessingFee.ToString("N2")</td></tr> }</tbody><tfoot><tr><th scope="rowgroup" colspan="3">Collections subtotal</th><td class="text-end">@collections.ToString("N2") JMD</td><td class="text-end">@Model.TotalTxnProcessingFee.ToString("N2") JMD</td></tr></tfoot></table></div> }
    </section>
    <section aria-labelledby="payrolls-heading"><h2 id="payrolls-heading">Linked payrolls</h2>
        @if (!Model.Payrolls.Any()) { <p>No payrolls are attached.</p> } else { <div class="table-responsive"><table class="table table-sm table-bordered"><caption>Payrolls and ordered payroll entries included in this payment</caption><thead><tr><th scope="col">Payroll</th><th scope="col">Period ending</th><th scope="col">Entry</th><th scope="col">Category</th><th scope="col" class="text-end">Amount (JMD)</th></tr></thead><tbody>@foreach (var item in Model.Payrolls.OrderBy(x => x.Payroll.SequenceNo)) { foreach (var entry in item.Payroll.Entries.OrderBy(x => x.SortOrder)) { <tr><th scope="row">#@item.Payroll.SequenceNo</th><td>@item.Payroll.PeriodEndingDate.ToString("yyyy-MM-dd")</td><td>@entry.Description</td><td>@entry.Type</td><td class="text-end">@entry.Amount.ToString("N2")</td></tr> } <tr class="table-light"><th scope="rowgroup" colspan="4">Payroll #@item.Payroll.SequenceNo subtotal</th><td class="text-end">@item.Payroll.PayrollTotal.ToString("N2") JMD</td></tr> }</tbody><tfoot><tr><th scope="rowgroup" colspan="4">Payrolls subtotal</th><td class="text-end">@payrolls.ToString("N2") JMD</td></tr></tfoot></table></div> }
    </section>
    <section aria-labelledby="deductions-heading"><h2 id="deductions-heading">Deductions</h2>
        @if (!Model.Deductions.Any()) { <p>No deductions are attached.</p> } else { <div class="table-responsive"><table class="table table-sm table-bordered"><caption>Deductions applied to this payment</caption><thead><tr><th scope="col">Description</th><th scope="col" class="text-end">Amount (JMD)</th></tr></thead><tbody>@foreach (var item in Model.Deductions) { <tr><th scope="row">@item.Description</th><td class="text-end">-@item.Amount.ToString("N2")</td></tr> }</tbody><tfoot><tr><th scope="rowgroup">Deductions subtotal</th><td class="text-end">-@Model.TotalDeductions.ToString("N2") JMD</td></tr></tfoot></table></div> }
    </section>
    <section aria-labelledby="total-heading"><h2 id="total-heading">Total calculation</h2><div class="table-responsive"><table class="table table-sm table-bordered w-auto"><caption>Payment total calculation</caption><tbody><tr><th scope="row">Job total</th><td class="text-end">@Model.JobTotal.ToString("N2") JMD</td></tr><tr><th scope="row">Client processing fee</th><td class="text-end">-@Model.ClientProcessingFee.ToString("N2") JMD</td></tr><tr><th scope="row">Transaction processing fees</th><td class="text-end">-@Model.TotalTxnProcessingFee.ToString("N2") JMD</td></tr><tr><th scope="row">Deductions</th><td class="text-end">-@Model.TotalDeductions.ToString("N2") JMD</td></tr></tbody><tfoot><tr><th scope="row">Total paid</th><td class="text-end">@Model.TotalPaid.ToString("N2") JMD</td></tr></tfoot></table></div></section>
    <p class="no-print"><button type="button" class="btn btn-primary" onclick="window.print()">Print</button></p>
</article>

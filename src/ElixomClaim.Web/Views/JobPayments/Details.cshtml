@model ElixomClaim.Lib.Entities.JobPayment
@{ ViewData["Title"] = $"Job payment #{Model.Id}"; }
<h1>Job payment #@Model.Id</h1><p><strong>Payee:</strong> @(Model.PayeeUser?.FullName ?? Model.CollectionClient?.Name)</p><p><strong>Status:</strong> @Model.Status</p><p><strong>Total paid:</strong> @Model.TotalPaid.ToString("N2") JMD</p><h2 class="h4">Claims</h2><ul>@foreach(var item in Model.Claims){<li>@item.Claim.Title — @item.Claim.Amount.ToString("N2") JMD</li>}</ul><h2 class="h4">Collections</h2><ul>@foreach(var item in Model.Collections){<li>#@item.CollectionTransactionId — @item.CollectionTransaction.Amount.ToString("N2") JMD</li>}</ul>@if(Model.CollectionClientId.HasValue){<a asp-action="Collections" asp-route-id="@Model.Id" class="btn btn-outline-primary">Review collected transactions</a>} <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-secondary">Print</a>@if(Model.Status == ElixomClaim.Lib.Entities.JobPaymentStatus.Paid){<form method="post" asp-action="Resend" asp-route-id="@Model.Id" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-outline-primary">Resend payout notification</button></form>}

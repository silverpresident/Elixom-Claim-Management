@model IEnumerable<ElixomClaim.Lib.Entities.JobPayment>
@{ ViewData["Title"] = "Job payments"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Job payments</h1>
    <a asp-action="Create" class="btn btn-primary">Create job payment</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No job payments have been created. Create a Processing job, then attach the accepted claims or collected transactions it will settle.
    </div>
}
else
{
    <table class="table">
        <thead><tr><th>Payment no.</th><th>Payee</th><th>Total</th><th>Status</th></tr></thead>
        <tbody>
            @foreach (var job in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@job.Id">#@job.SequenceNo</a></td>
                    <td>@(job.PayeeUser?.FullName ?? job.CollectionClient?.Name)</td>
                    <td>@job.TotalPaid.ToString("N2") JMD</td>
                    <td>@job.Status</td>
                </tr>
            }
        </tbody>
    </table>
}

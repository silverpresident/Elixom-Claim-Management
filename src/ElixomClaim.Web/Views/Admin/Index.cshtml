@{ ViewData["Title"] = "Administration"; }

<div class="container my-4">
    <div class="mb-4"><h2 class="mb-1">Administration</h2><p class="text-muted mb-0">Review system configuration, audit activity, and notification delivery.</p></div>
    <div class="row g-4">
        <div class="col-md-4"><div class="card h-100 shadow-sm border-0"><div class="card-body"><h3 class="h5">User management</h3><p class="display-6 mb-2">@ViewBag.UserCount</p><p class="text-muted">Provisioned users and their application roles.</p><a asp-action="Users" class="btn btn-outline-primary">Review users</a></div></div></div>
        <div class="col-md-4"><div class="card h-100 shadow-sm border-0"><div class="card-body"><h3 class="h5">Audit records</h3><p class="display-6 mb-2">@ViewBag.RecentAuditCount</p><p class="text-muted">Events recorded in the last seven days.</p><a asp-action="AuditLogs" class="btn btn-outline-primary">Review audit records</a></div></div></div>
        <div class="col-md-4"><div class="card h-100 shadow-sm border-0"><div class="card-body"><h3 class="h5">Email delivery</h3><p class="display-6 mb-2">@ViewBag.PendingEmailCount</p><p class="text-muted">Pending or in-progress notification deliveries.</p><a asp-action="EmailLogs" class="btn btn-outline-primary">Review email delivery</a></div></div></div>
    </div>
</div>

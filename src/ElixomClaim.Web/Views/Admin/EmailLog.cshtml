@model ElixomClaim.Lib.Entities.EmailLog
@{ ViewData["Title"] = "Email Delivery Detail"; }

<div class="container my-4"><div class="d-flex justify-content-between align-items-center mb-4"><h2>Email Delivery Detail</h2><a asp-action="EmailLogs" class="btn btn-outline-secondary">Back to email delivery</a></div>
<div class="card shadow-sm border-0 mb-4"><div class="card-body"><dl class="row mb-0"><dt class="col-sm-3">To</dt><dd class="col-sm-9">@Model.To</dd><dt class="col-sm-3">From</dt><dd class="col-sm-9">@Model.From</dd><dt class="col-sm-3">Subject</dt><dd class="col-sm-9">@Model.Subject</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status (attempt @Model.AttemptNumber)</dd><dt class="col-sm-3">Provider</dt><dd class="col-sm-9">@Model.Provider</dd><dt class="col-sm-3">Created</dt><dd class="col-sm-9">@Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd><dt class="col-sm-3">Sent</dt><dd class="col-sm-9">@(Model.SentAtUtc?.ToString("yyyy-MM-dd HH:mm:ss") ?? "Not sent") UTC</dd><dt class="col-sm-3">Failure detail</dt><dd class="col-sm-9">@(Model.FailureReason ?? "—")</dd></dl></div></div>
<section class="card shadow-sm border-0"><div class="card-header bg-light"><h3 class="h5 mb-0">Stored HTML source</h3></div><div class="card-body"><p class="small text-muted">Displayed as encoded source to prevent message markup from executing in the administration application.</p><pre class="bg-light border rounded p-3 mb-0 text-wrap" style="white-space: pre-wrap;">@Model.HtmlBody</pre></div></section></div>

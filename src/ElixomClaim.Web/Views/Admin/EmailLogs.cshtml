@model IEnumerable<ElixomClaim.Lib.Entities.EmailLog>
@{ ViewData["Title"] = "Email Delivery"; }

<div class="container-fluid my-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="mb-1">Email Delivery</h2><p class="text-muted mb-0">The 200 most recent delivery outcomes. Message bodies are available only to Administrators.</p></div><a asp-action="Index" class="btn btn-outline-secondary">Back to Administration</a></div>
    <div class="card shadow-sm border-0"><div class="card-body p-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Created (UTC)</th><th>To</th><th>Subject</th><th>Provider</th><th>Status</th><th>Attempts</th><th>Related record</th><th></th></tr></thead><tbody>
    @if (!Model.Any()) { <tr><td colspan="8" class="text-center text-muted p-4">No email delivery records are available.</td></tr> }
    @foreach (var log in Model) { <tr><td>@log.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td><td>@log.To</td><td>@log.Subject</td><td>@log.Provider</td><td><span class="badge @(log.Status == ElixomClaim.Lib.Entities.EmailOutboxStatus.Sent ? "bg-success" : log.Status == ElixomClaim.Lib.Entities.EmailOutboxStatus.Failed ? "bg-danger" : "bg-secondary")">@log.Status</span></td><td>@log.AttemptNumber</td><td><small>@log.RelatedEntityType @log.RelatedEntityId</small></td><td><a asp-action="EmailLog" asp-route-id="@log.Id" class="btn btn-sm btn-outline-primary">View</a></td></tr> }
    </tbody></table></div></div></div>
</div>

@model IEnumerable<ElixomClaim.Web.Models.AuditRecordViewModel>
@{
    ViewData["Title"] = "Audit Logs";
    bool isAdministrator = ViewBag.IsAdministrator ?? false;
}

<div class="container-fluid my-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>System Audit Logs</h2>
        @if (isAdministrator)
        {
            <span class="badge bg-primary">Administrator (Full Detail View)</span>
        }
        else
        {
            <span class="badge bg-info text-dark">Manager (Operational Metadata View)</span>
        }
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Timestamp (UTC)</th>
                            <th>Actor</th>
                            <th>Action</th>
                            <th>Target</th>
                            <th>Correlation ID</th>
                            <th>MCP</th>
                            @if (isAdministrator)
                            {
                                <th>State Changes</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td>@log.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@(log.ActorEmail ?? "System")</td>
                                <td><span class="badge bg-secondary">@log.Action</span></td>
                                <td><code>@log.Target</code></td>
                                <td><small class="text-muted">@log.CorrelationId</small></td>
                                <td>
                                    @if (log.IsMcpOperation)
                                    {
                                        <span class="badge bg-warning text-dark">MCP</span>
                                    }
                                </td>
                                @if (isAdministrator)
                                {
                                    <td>
                                        @if (!string.IsNullOrEmpty(log.AfterStateJson))
                                        {
                                            <details>
                                                <summary class="btn btn-sm btn-link p-0 text-decoration-none">View State</summary>
                                                <pre class="bg-light p-2 rounded mb-0 mt-1" style="max-width: 300px; font-size: 0.75rem;">@log.AfterStateJson</pre>
                                            </details>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

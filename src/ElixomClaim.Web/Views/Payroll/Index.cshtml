@model ElixomClaim.Web.Models.PayrollWorkspaceViewModel
@{ ViewData["Title"] = "Salary & Payroll"; }
<h1>Salary &amp; Payroll</h1><p><a asp-action="Create" class="btn btn-primary">Create salary definition</a></p>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success" role="status">@success</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
<section aria-labelledby="salary-definitions"><h2 id="salary-definitions">Salary definitions</h2>
@if (!Model.SalaryDefinitions.Any()) { <p class="text-muted">No salary definitions are configured.</p> } else { <div class="table-responsive"><table class="table"><thead><tr><th>Person</th><th>Description</th><th>Base</th><th>Next due preview</th><th></th></tr></thead><tbody>@foreach (var definition in Model.SalaryDefinitions) { <tr><td>@definition.User.FullName</td><td>@definition.Description</td><td>@definition.BaseAmount.ToString("N2") JMD</td><td>@definition.LastSalaryDate.AddMonths(definition.RecurrenceMonths).AddDays(definition.RecurrenceDays).ToString("yyyy-MM-dd")</td><td><form method="post" action="/payroll/salary-definitions/@definition.Id/generate"><button class="btn btn-primary" type="submit">Generate now</button></form></td></tr> }</tbody></table></div> }
</section>
<section aria-labelledby="payroll-audit"><h2 id="payroll-audit">Recent audit history</h2><ul class="list-group">@foreach (var audit in Model.AuditRecords) { <li class="list-group-item"><time datetime="@audit.TimestampUtc.ToString("O")">@audit.TimestampUtc.ToString("u")</time> — @audit.Action (@audit.Target)</li> }</ul></section>
<section aria-labelledby="payrolls"><h2 id="payrolls">Recent payrolls</h2><div class="table-responsive"><table class="table"><thead><tr><th>Person</th><th>Period</th><th>Total</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var payroll in Model.Payrolls) { <tr><td>@payroll.User.FullName</td><td>@payroll.PeriodEndingDate.ToString("yyyy-MM-dd")</td><td>@payroll.PayrollTotal.ToString("N2") JMD</td><td>@payroll.Status</td><td>@if (payroll.Status == ElixomClaim.Lib.Entities.PayrollStatus.Generated) { <form method="post" action="/payroll/@payroll.Id/submit"><button class="btn btn-outline-primary" type="submit">Submit</button></form> }</td></tr> }</tbody></table></div></section>

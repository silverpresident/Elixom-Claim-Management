@model ElixomClaim.Web.Models.PayrollWorkspaceViewModel
@using ElixomClaim.Lib.Entities
@{ ViewData["Title"] = Model.IsHistory ? "Payroll History" : "Payroll Workspace"; }

<div class="container my-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
        <div><h2 class="mb-1">@(Model.IsHistory ? "Payroll History" : "Payroll Workspace")</h2><p class="text-muted mb-0">@(Model.IsHistory ? "Completed payroll runs retained for reference." : "Payroll runs that still need payroll or payment action.")</p></div>
        <div class="btn-group" role="group" aria-label="Payroll views"><a asp-action="Index" class="btn @(Model.IsHistory ? "btn-outline-primary" : "btn-primary")">Current work</a><a asp-action="History" class="btn @(Model.IsHistory ? "btn-primary" : "btn-outline-primary")">Paid history</a></div>
    </div>
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    <section class="card shadow-sm border-0 mb-5"><div class="card-header bg-primary text-white"><h5 class="mb-0">@(Model.IsHistory ? "Paid Payroll Runs" : "Outstanding Payroll Runs")</h5></div><div class="card-body p-0">
        @if (!Model.Payrolls.Any()) { <div class="p-4 text-center text-muted">@(Model.IsHistory ? "No paid payroll runs yet." : "No outstanding payroll work. Generated and submitted payrolls appear here.")</div> }
        else { <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Payroll no. / Employee</th><th>Period ending</th><th>Itemized entries</th><th>Payroll total</th><th>Status</th><th>Actions</th></tr></thead><tbody>
        @foreach (var payroll in Model.Payrolls) {
            <tr id="payroll-@payroll.Id"><td><strong>Payroll #@payroll.SequenceNo — @payroll.User.FullName</strong><div class="small text-muted">@payroll.User.Email</div></td><td>@payroll.PeriodEndingDate.ToString("yyyy-MM-dd")</td><td><ul class="list-unstyled mb-0 small">@foreach (var entry in payroll.Entries.OrderBy(e => e.SortOrder)) { <li><code>Entry #@entry.SequenceNo [@entry.Type]</code> @entry.Description: <strong>$@entry.Amount.ToString("N2") JMD</strong></li> }</ul></td><td class="fw-bold">$@payroll.PayrollTotal.ToString("N2") JMD</td><td><span class="badge @(payroll.Status == PayrollStatus.Generated ? "bg-info text-dark" : payroll.Status == PayrollStatus.Submitted ? "bg-primary" : "bg-success")">@payroll.Status</span></td><td>@if (payroll.Status == PayrollStatus.Generated) { <div class="d-flex flex-column gap-1"><form method="post" asp-action="Submit" asp-route-id="@payroll.Id">@Html.AntiForgeryToken()<button class="btn btn-sm btn-success w-100">Submit to job</button></form><button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#customEntryForm-@payroll.Id">Custom entry</button></div> }</td></tr>
            @if (payroll.Status == PayrollStatus.Generated) { <tr class="collapse bg-light" id="customEntryForm-@payroll.Id"><td colspan="6" class="p-3"><form method="post" asp-action="AddCustomEntry" asp-route-id="@payroll.Id" class="row g-2 align-items-center">@Html.AntiForgeryToken()<div class="col-md-5"><input type="text" name="description" class="form-control form-control-sm" placeholder="Custom entry description" required /></div><div class="col-md-4"><input type="number" name="amount" step="0.01" class="form-control form-control-sm" placeholder="Amount (+ or - JMD)" required /></div><div class="col-md-3"><button type="submit" class="btn btn-sm btn-primary w-100">Add entry</button></div></form></td></tr> }
        }
        </tbody></table></div> }
    </div></section>
    @if (Model.IsHistory && Model.AuditRecords.Any()) { <section class="card shadow-sm border-0"><div class="card-header bg-light"><h5 class="mb-0">Recent Payroll Audit Events</h5></div><ul class="list-group list-group-flush">@foreach (var audit in Model.AuditRecords) { <li class="list-group-item d-flex justify-content-between"><span><strong>@audit.Action</strong> — <small class="text-muted">@audit.Target</small></span><time datetime="@audit.TimestampUtc.ToString("O")" class="small text-muted">@audit.TimestampUtc.ToString("yyyy-MM-dd HH:mm") UTC</time></li> }</ul></section> }
</div>

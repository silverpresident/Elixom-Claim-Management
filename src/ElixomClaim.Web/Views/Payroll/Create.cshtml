@model ElixomClaim.Web.Controllers.CreateSalaryDefinitionInput
@{
    ViewData["Title"] = "Create salary definition";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-xl-10 col-xxl-9">
            <a asp-action="Index" class="link-secondary text-decoration-none small d-inline-block mb-3">← Back to salary definitions</a>

            <div class="mb-4">
                <h1 class="h2 mb-1">Create salary definition</h1>
                <p class="text-muted mb-0">Set the employee’s base pay and the schedule used to generate future payrolls.</p>
            </div>

            <form method="post" class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h2 class="h5 mb-0">Salary rule details</h2>
                </div>
                <div class="card-body p-4 p-md-5">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <fieldset class="mb-4">
                        <legend class="h6 border-bottom pb-2 mb-3">Payee and pay</legend>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="UserId" class="form-label fw-semibold">Payee</label>
                                <select asp-for="UserId" class="form-select" asp-items="@(new SelectList(ViewBag.Users, "Id", "FullName"))">
                                    <option value="">Choose a payee</option>
                                </select>
                                <span asp-validation-for="UserId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Description" class="form-label fw-semibold">Description</label>
                                <input asp-for="Description" class="form-control" placeholder="e.g. Monthly base salary" required aria-describedby="description-help" />
                                <div id="description-help" class="form-text">A short label to identify this salary rule.</div>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="BaseAmount" class="form-label fw-semibold">Base amount (JMD)</label>
                                <div class="input-group">
                                    <span class="input-group-text">JMD</span>
                                    <input asp-for="BaseAmount" type="number" min="0.01" step="0.01" class="form-control" placeholder="0.00" required />
                                </div>
                                <span asp-validation-for="BaseAmount" class="text-danger small"></span>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="mb-4">
                        <legend class="h6 border-bottom pb-2 mb-3">Effective dates</legend>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="StartDate" class="form-label fw-semibold">Start date</label>
                                <input asp-for="StartDate" type="date" class="form-control" required />
                                <div class="form-text">When this rule takes effect.</div>
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="FirstSalaryDate" class="form-label fw-semibold">First salary date</label>
                                <input asp-for="FirstSalaryDate" type="date" class="form-control" required />
                                <div class="form-text">The first date used for recurrence.</div>
                                <span asp-validation-for="FirstSalaryDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="EndDate" class="form-label fw-semibold">End date <span class="text-muted fw-normal">(optional)</span></label>
                                <input asp-for="EndDate" type="date" class="form-control" />
                                <div class="form-text">Leave empty for an ongoing salary.</div>
                                <span asp-validation-for="EndDate" class="text-danger small"></span>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset>
                        <legend class="h6 border-bottom pb-2 mb-3">Recurrence schedule</legend>
                        <p class="form-text mb-3">Set at least one recurrence interval, then choose the weekday nearest to each due date.</p>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="RecurrenceMonths" class="form-label fw-semibold">Repeat every months</label>
                                <input asp-for="RecurrenceMonths" type="number" min="0" step="1" class="form-control" value="@(Model?.RecurrenceMonths > 0 ? Model.RecurrenceMonths : 1)" />
                                <span asp-validation-for="RecurrenceMonths" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="RecurrenceDays" class="form-label fw-semibold">Plus days</label>
                                <input asp-for="RecurrenceDays" type="number" min="0" step="1" class="form-control" value="@(Model?.RecurrenceDays ?? 0)" />
                                <span asp-validation-for="RecurrenceDays" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="NearestWeekday" class="form-label fw-semibold">Nearest weekday</label>
                                <select asp-for="NearestWeekday" asp-items="Html.GetEnumSelectList<DayOfWeek>()" class="form-select"></select>
                                <span asp-validation-for="NearestWeekday" class="text-danger small"></span>
                            </div>
                        </div>
                    </fieldset>
                </div>
                <div class="card-footer bg-white d-flex flex-wrap align-items-center gap-2 py-3 px-4 px-md-5">
                    <button type="submit" class="btn btn-primary px-4">Create salary definition</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

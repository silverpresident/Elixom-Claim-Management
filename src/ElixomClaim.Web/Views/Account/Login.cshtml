@{
    ViewData["Title"] = "Sign In";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow border-0 rounded-3">
            <div class="card-body p-4 p-md-5 text-center">
                <img src="~/favicon.svg" alt="Elixom Claim Logo" width="64" height="64" class="mb-3" />
                <h1 class="h3 fw-bold text-primary mb-2">Elixom Claim</h1>
                <p class="text-muted mb-4">Secure Claim & Payment Operations System</p>

                <form asp-action="ExternalLogin" method="post" asp-route-returnUrl="@returnUrl">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-dark btn-lg w-100 d-flex align-items-center justify-content-center gap-2 py-2 fw-semibold">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-google" viewBox="0 0 16 16">
                            <path d="M15.545 6.558a9.4 9.4 0 0 1 .139 1.626c0 2.434-.87 4.492-2.384 5.885h.002C11.978 15.292 10.158 16 8 16A8 8 0 1 1 8 0a7.7 7.7 0 0 1 5.352 2.082l-2.284 2.284A4.35 4.35 0 0 0 8 3.166c-2.087 0-3.86 1.408-4.492 3.304a4.8 4.8 0 0 0 0 3.063h.003c.635 1.893 2.405 3.301 4.492 3.301 1.078 0 2.004-.276 2.722-.764h-.003a3.7 3.7 0 0 0 1.599-2.431H8v-3.08z"/>
                        </svg>
                        <span>Sign in with Google</span>
                    </button>
                </form>

                <div class="mt-4 pt-3 border-top text-muted small">
                    <p class="mb-1">Access is restricted to pre-provisioned active user accounts.</p>
                    <p class="mb-0">Need assistance? Contact <a href="mailto:privacy@elixom.com" class="text-decoration-none">privacy@elixom.com</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
